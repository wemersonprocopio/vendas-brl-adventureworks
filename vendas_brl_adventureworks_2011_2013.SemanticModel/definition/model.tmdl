model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["clientes","data","produtos","revendas","territorios","vendas","AnosAnalise"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table clientes
ref table data
ref table produtos
ref table revendas
ref table territorios
ref table vendas

ref cultureInfo pt-BR

