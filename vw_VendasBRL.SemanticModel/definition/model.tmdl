model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimCustomer","DimDate","DimProduct","DimReseller","DimSalesTerritory","vw_VendasBRL","AnosAnalise"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table DimCustomer
ref table DimDate
ref table DimProduct
ref table DimReseller
ref table DimSalesTerritory
ref table vw_VendasBRL

ref cultureInfo pt-BR

